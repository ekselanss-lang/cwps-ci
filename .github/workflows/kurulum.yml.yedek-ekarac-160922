name: kurulum
on: [push, workflow_dispatch]
jobs:
  k:
    runs-on: windows-latest
    timeout-minutes: 55
    steps:
      - uses: actions/checkout@v4
      - name: Kaynagi coz
        shell: pwsh
        run: |
          # KURULUM DOSYASI DUZELTMESI: sifreli arsivde ESKI CWPS.iss vardi (keygen'i paketliyordu +
          # sonda onay kutusu acip sessiz kurulumu 45 dk kilitliyordu ✗). Repo'daki DOGRU surum kullanilir ✓
          Copy-Item CWPS.iss CWPS.iss.repo -Force
          openssl enc -d -aes-256-cbc -pbkdf2 -iter 200000 -in kaynak.enc -out k.tar.gz -k ${{ secrets.PAKET_SIFRE }}
          tar -xzf k.tar.gz
          Copy-Item CWPS.iss.repo CWPS.iss -Force
          Remove-Item CWPS.iss.repo -Force
          Get-ChildItem -File | Select-Object Name,Length | Format-Table -AutoSize | Out-String
      - name: MSYS2 + mingw kur (github sunucusu)
        uses: msys2/setup-msys2@v2
        with:
          msystem: MINGW64
          update: false
          install: mingw-w64-x86_64-gcc
      - name: CWPS.exe + Keygen DERLE (github windows - oracle degil)
        shell: msys2 {0}
        run: |
          g++ -O2 -s -mwindows -std=c++17 -static -static-libgcc -static-libstdc++ -DWIN32_LEAN_AND_MEAN -o CWPS.exe dis.cpp motor.cpp -lws2_32 -ladvapi32 -lcrypt32 -lole32 -luuid -lshell32 -liphlpapi -lwininet -lcomctl32 -lgdi32
          g++ -O2 -s -mwindows -std=c++17 -static -static-libgcc -static-libstdc++ -DWIN32_LEAN_AND_MEAN -o CWPS-Keygen.exe keygen_gui.cpp -lcomctl32 -lgdi32 -lcomdlg32 -luser32
          ls -la CWPS.exe CWPS-Keygen.exe
      - name: Surum basligi duzeltmesi (9.8 -> 9.9)
        shell: pwsh
        run: |
          $d = Get-Content dis.cpp -Raw
          $y = $d -replace '<title>CYBERWOLF SECURITY 9\.8</title>','<title>CYBERWOLF SECURITY 9.9</title>'
          if ($y -ne $d) { Set-Content dis.cpp $y -NoNewline; Write-Host "pencere basligi 9.9 yapildi ✓" } else { Write-Host "baslik zaten guncel ✓" }
      - name: Inno Setup kur
        shell: pwsh
        run: choco install innosetup -y --no-progress
      - name: Diller klasoru kontrol (Turkish.isl)
        shell: pwsh
        run: |
          $d="C:\Program Files (x86)\Inno Setup 6\Languages"
          if(Test-Path $d){ (Get-ChildItem $d -Filter *.isl | Select-Object -ExpandProperty Name) -join ", " }
          else { Write-Host "DIL KLASORU YOK" }
      - name: Gomulu araclari indir (8 arac)
        shell: pwsh
        run: |
          New-Item -ItemType Directory -Force -Path araclar | Out-Null
          foreach ($r in @("subfinder","httpx","naabu","katana","dnsx")) {
            $rel = Invoke-RestMethod "https://api.github.com/repos/projectdiscovery/$r/releases/latest"
            $a = $rel.assets | Where-Object { $_.name -like "*windows_amd64.zip" } | Select-Object -First 1
            Write-Host "$r -> $($a.name)"
            Invoke-WebRequest $a.browser_download_url -OutFile "$r.zip" -UseBasicParsing
            Expand-Archive "$r.zip" -DestinationPath "t_$r" -Force
            $exe = Get-ChildItem "t_$r" -Recurse -Filter "$r.exe" | Select-Object -First 1
            Copy-Item $exe.FullName "araclar\$r.exe" -Force
          }
          Invoke-WebRequest "https://github.com/ffuf/ffuf/releases/download/v2.1.0/ffuf_2.1.0_windows_amd64.zip" -OutFile ffuf.zip -UseBasicParsing
          Expand-Archive ffuf.zip -DestinationPath t_ffuf -Force
          Copy-Item (Get-ChildItem t_ffuf -Recurse -Filter ffuf.exe | Select-Object -First 1).FullName "araclar\ffuf.exe" -Force
          Invoke-WebRequest "https://github.com/OJ/gobuster/releases/download/v3.6.0/gobuster_Windows_x86_64.zip" -OutFile gb.zip -UseBasicParsing
          Expand-Archive gb.zip -DestinationPath t_gb -Force
          Copy-Item (Get-ChildItem t_gb -Recurse -Filter gobuster.exe | Select-Object -First 1).FullName "araclar\gobuster.exe" -Force
          Invoke-WebRequest "https://nmap.org/dist/nmap-7.92-win32.zip" -OutFile nmap.zip -UseBasicParsing
          Expand-Archive nmap.zip -DestinationPath t_nmap -Force
          Copy-Item (Get-ChildItem t_nmap -Recurse -Filter nmap.exe | Select-Object -First 1).FullName "araclar\nmap.exe" -Force
          # ONCE KENDI SUNUCUMUZDAN (hizli + guvenilir), olmazsa GitHub'dan ✓
          try {
            Invoke-WebRequest "https://script.cyberwolfsec.com/indir/araclar/nuclei.exe" -OutFile "araclar\nuclei.exe" -UseBasicParsing
            Write-Host "nuclei kendi sunucumuzdan alindi"
          } catch { Write-Host ("kendi sunucudan alinamadi: " + $_) }
          $ok = Test-Path "araclar\nuclei.exe"
          $ok=$false
          foreach ($v in @("v3.4.10","v3.3.9","v3.3.7","v3.2.9")) {
            if ($ok) { break }
            try {
              $s = $v.TrimStart("v")
              Invoke-WebRequest "https://github.com/projectdiscovery/nuclei/releases/download/$v/nuclei_$s`_windows_amd64.zip" -OutFile nuclei.zip -UseBasicParsing
              Expand-Archive nuclei.zip -DestinationPath t_nuclei -Force
              Copy-Item (Get-ChildItem t_nuclei -Recurse -Filter nuclei.exe | Select-Object -First 1).FullName "araclar\nuclei.exe" -Force
              $ok = Test-Path "araclar\nuclei.exe"
              if ($ok) { Write-Host "nuclei paketlendi ($v)" }
            } catch { Write-Host ("nuclei $v indirilemedi") }
          }
          if (-not $ok) {
            try {
              $n = Invoke-RestMethod "https://api.github.com/repos/projectdiscovery/nuclei/releases/latest"
              $na = $n.assets | Where-Object { $_.name -like "*windows_amd64.zip" } | Select-Object -First 1
              Invoke-WebRequest $na.browser_download_url -OutFile nuclei.zip -UseBasicParsing
              Expand-Archive nuclei.zip -DestinationPath t_nuclei -Force
              Copy-Item (Get-ChildItem t_nuclei -Recurse -Filter nuclei.exe | Select-Object -First 1).FullName "araclar\nuclei.exe" -Force
            } catch { Write-Host ("nuclei API indirilemedi: " + $_) }
          }
          # ZORUNLU KONTROL: 9 aracin hepsi pakete girmeli, eksikse derleme DURUR ✗
          $bekle=@("nmap","ffuf","gobuster","nuclei","subfinder","httpx","naabu","katana","dnsx")
          $eksik=@(); foreach($b in $bekle){ if(-not (Test-Path "araclar\$b.exe")){ $eksik += $b } }
          if($eksik.Count -gt 0){ Write-Host ("EKSIK ARACLAR: " + ($eksik -join ", ")); exit 1 }
          Write-Host ("TAM " + $bekle.Count + " ARAC HAZIR: " + ($bekle -join ", "))
          Write-Host "=== ARAÇLAR ==="
          Get-ChildItem araclar | Select-Object Name,Length | Format-Table -AutoSize | Out-String
      - name: KURULUM DERLE (musteri)
        shell: pwsh
        run: |
          & "C:\Program Files (x86)\Inno Setup 6\ISCC.exe" CWPS.iss | Select-Object -Last 12
          Get-ChildItem Output | Select-Object Name,Length | Format-Table -AutoSize | Out-String
      - name: KURULUM DERLE (satici)
        shell: pwsh
        run: |
          & "C:\Program Files (x86)\Inno Setup 6\ISCC.exe" /DSATICI /OOutputSatici CWPS.iss | Select-Object -Last 8
          Get-ChildItem OutputSatici | Select-Object Name,Length | Format-Table -AutoSize | Out-String
      - name: SUNUCUYA YUKLE (kurulum paketleri - oracle'a degil)
        if: always()
        shell: bash
        env:
          SUNUCU_KEY: ${{ secrets.SUNUCU_KEY }}
          SUNUCU_HOST: ${{ secrets.SUNUCU_HOST }}
          SUNUCU_PORT: ${{ secrets.SUNUCU_PORT }}
          SUNUCU_KULLANICI: ${{ secrets.SUNUCU_KULLANICI }}
        run: |
          H="${SUNUCU_HOST:-96.47.167.18}"; P="${SUNUCU_PORT:-1588}"; U="${SUNUCU_KULLANICI:-script42}"
          if [ -z "$SUNUCU_KEY" ]; then echo "SUNUCU_KEY yok - atlandi"; exit 0; fi
          mkdir -p ~/.ssh && printf '%s\n' "$SUNUCU_KEY" > ~/.ssh/id_sunucu && chmod 600 ~/.ssh/id_sunucu
          ssh-keyscan -p "$P" "$H" >> ~/.ssh/known_hosts 2>/dev/null || true
          ls -la Output OutputSatici 2>/dev/null || true
          # GUVENLI YUKLEME: once .yeni olarak at, sha256 dogrula, sonra yerine koy ✓
          # (yarim kalan yukleme = bozuk kurulum dosyasi / "setup files are corrupted" sorunu)
          for f in Output/*.exe OutputSatici/*.exe; do
            [ -f "$f" ] || continue
            b=$(basename "$f")
            if ! scp -i ~/.ssh/id_sunucu -P "$P" -o StrictHostKeyChecking=no "$f" "$U@$H:~/public_html/indir/$b.yeni"; then
              echo "HATA  $b yuklenemedi (mevcut dosya korundu)"; continue
            fi
            L=$(sha256sum "$f" | cut -d" " -f1)
            R=$(ssh -i ~/.ssh/id_sunucu -p "$P" -o StrictHostKeyChecking=no "$U@$H" "sha256sum ~/public_html/indir/$b.yeni 2>/dev/null | cut -d\" \" -f1")
            if [ "$L" = "$R" ]; then
              ssh -i ~/.ssh/id_sunucu -p "$P" -o StrictHostKeyChecking=no "$U@$H" "mv -f ~/public_html/indir/$b.yeni ~/public_html/indir/$b"
              echo "TAMAM $b  (boyut $(stat -c%s \"$f\") B, sha ${L:0:16}...)  DOGRULANDI ✓"
            else
              echo "HATA  $b sha256 UYUSMUYOR - yuklenmedi (yerel ${L:0:16} / sunucu ${R:0:16})"
              ssh -i ~/.ssh/id_sunucu -p "$P" -o StrictHostKeyChecking=no "$U@$H" "rm -f ~/public_html/indir/$b.yeni"
            fi
          done
          ssh -i ~/.ssh/id_sunucu -p "$P" -o StrictHostKeyChecking=no "$U@$H" 'ls -la ~/public_html/indir/ | tail -8'

      - name: GERCEK KURULUM TESTI (sessiz kur + dosya kontrol)
        shell: pwsh
        run: |
          $setup = (Get-ChildItem Output -Filter *.exe | Select-Object -First 1)
          Write-Host ("KURULUM PAKETI: " + $setup.Name + "  " + [Math]::Round($setup.Length/1MB,1) + " MB")
          $p = Start-Process $setup.FullName -ArgumentList "/VERYSILENT","/SUPPRESSMSGBOXES","/NORESTART","/DIR=C:\CWPS-TEST","/LOG=C:\kurulum.log" -PassThru -Wait
          Write-Host ("CIKIS KODU: " + $p.ExitCode)
          Start-Sleep -Seconds 3
          $ok=0; $hata=0
          function Kontrol($ad,$yol){
            if(Test-Path $yol){ Write-Host ("PASS  " + $ad + " -> " + [Math]::Round((Get-Item $yol).Length/1KB,0) + " KB"); $script:ok++ }
            else { Write-Host ("FAIL  " + $ad + " YOK -> " + $yol); $script:hata++ } }
          Kontrol "CWPS.exe"            "C:\CWPS-TEST\CWPS.exe"
          Kontrol "OKU-BENI.txt"        "C:\CWPS-TEST\OKU-BENI.txt"
          Kontrol "LISANS.txt"          "C:\CWPS-TEST\LISANS.txt"
          Kontrol "araclar\nmap.exe"    "C:\CWPS-TEST\araclar\nmap.exe"
          Kontrol "araclar\dnsx.exe"    "C:\CWPS-TEST\araclar\dnsx.exe"
          Kontrol "araclar\katana.exe"    "C:\CWPS-TEST\araclar\katana.exe"
          Kontrol "araclar\naabu.exe"    "C:\CWPS-TEST\araclar\naabu.exe"
          Kontrol "araclar\httpx.exe"    "C:\CWPS-TEST\araclar\httpx.exe"
          Kontrol "araclar\subfinder.exe"    "C:\CWPS-TEST\araclar\subfinder.exe"
          Kontrol "araclar\nuclei.exe"    "C:\CWPS-TEST\araclar\nuclei.exe"
          Kontrol "araclar\gobuster.exe"    "C:\CWPS-TEST\araclar\gobuster.exe"
          Kontrol "araclar\ffuf.exe"    "C:\CWPS-TEST\araclar\ffuf.exe"
          Kontrol "araclar\subfinder.exe" "C:\CWPS-TEST\araclar\subfinder.exe"
          Kontrol "araclar\httpx.exe"   "C:\CWPS-TEST\araclar\httpx.exe"
          Kontrol "araclar\katana.exe"  "C:\CWPS-TEST\araclar\katana.exe"
          Kontrol "kaldirma araci"      "C:\CWPS-TEST\unins000.exe"
          if(Test-Path "C:\CWPS-TEST\CWPS-Keygen.exe"){ Write-Host "FAIL  MUSTERI surumunde KEYGEN var (olmamali)"; $hata++ }
          else { Write-Host "PASS  musteri surumunde keygen YOK"; $ok++ }
          # Program gercekten calisiyor mu? (motor ayaga kalkmali)
          $pr = Start-Process "C:\CWPS-TEST\CWPS.exe" -PassThru
          Start-Sleep -Seconds 14
          $port=0
          foreach($pt in 48921..48960){ try{ $r=Invoke-RestMethod "http://127.0.0.1:$pt/api/durum?t=cwps-yerel-9f3a7d" -TimeoutSec 3; $port=$pt; break }catch{} }
          if($port -gt 0){
            $l = Invoke-RestMethod "http://127.0.0.1:$port/api/lisans?t=cwps-yerel-9f3a7d" -TimeoutSec 20
            Write-Host ("PASS  kurulan program calisti: port=" + $port + " surum=" + $l.surum + " mod=" + $l.mod + " makine=" + $l.makine); $ok++
            # lisans yazma izni var mi? (Program Files yerine kullanici klasoru)
            $test = "C:\CWPS-TEST\yazma_testi.txt"
            try { Set-Content -Path $test -Value "ok" -ErrorAction Stop; Write-Host "PASS  program klasorune yazilabiliyor (lisans kaydedilebilir)"; $ok++; Remove-Item $test -Force } catch { Write-Host "FAIL  klasore yazilamiyor (lisans kaydedilemez)"; $hata++ }
          } else { Write-Host "FAIL  kurulan program motoru ayaga kalkmadi"; $hata++ }
          Stop-Process -Id $pr.Id -Force -ErrorAction SilentlyContinue
          Get-Process CWPS -ErrorAction SilentlyContinue | Stop-Process -Force -ErrorAction SilentlyContinue
          Write-Host ("=== KURULUM TESTI: PASS=" + $ok + " FAIL=" + $hata + " ===")
      - name: SATICI KURULUM TESTI (keygen kuruluyor mu - sure sinirli)
        shell: pwsh
        run: |
          function Kur($exe,$ad,$dizin,$sinir){
            $t0=Get-Date
            Write-Host ("--- " + $ad + " basliyor: " + $exe.Name + " (" + [Math]::Round($exe.Length/1MB,1) + " MB) -> " + $dizin)
            $p=Start-Process $exe.FullName -ArgumentList "/VERYSILENT","/SUPPRESSMSGBOXES","/NORESTART","/NOCANCEL","/DIR=$dizin","/LOG=$env:TEMP\kur-$ad.log" -PassThru
            $ok=$p.WaitForExit($sinir*1000)
            $sure=[Math]::Round(((Get-Date)-$t0).TotalSeconds,1)
            if(-not $ok){ Write-Host ("FAIL  " + $ad + " " + $sinir + " sn'de BITMEDI (PID " + $p.Id + ") - zorla kapatiliyor")
              Write-Host "--- TAKILMA ANINDA CALISAN SURECLER ---"
              Get-Process | Where-Object { $_.ProcessName -match "CWPS|unins|iu|msedge|powershell|cmd" } | Select-Object ProcessName,Id,StartTime | Format-Table -AutoSize | Out-String
              Get-ChildItem "$env:TEMP" -Filter "Setup Log*.txt" -ErrorAction SilentlyContinue | ForEach-Object { Write-Host ("--- INNO OTO LOG: " + $_.Name + " ---"); Get-Content $_.FullName -Tail 15 }
              Get-ChildItem "$env:TEMP" -Filter "*satici*" -ErrorAction SilentlyContinue | ForEach-Object { Write-Host ("--- LOG: " + $_.Name + " ---"); Get-Content $_.FullName -Tail 15 }; Stop-Process -Id $p.Id -Force -ErrorAction SilentlyContinue; taskkill /F /T /IM (($exe.Name) -replace "\.exe$","")  2>$null | Out-Null
              $lg="$env:TEMP\kur-$ad.log"; if(Test-Path $lg){ Write-Host "--- INNO LOG SON SATIRLAR ---"; Get-Content $lg -Tail 12 } ; return $false }
            Write-Host ("OK    " + $ad + " bitti (" + $sure + " sn, cikis kodu=" + $p.ExitCode + ")")
            $lg="$env:TEMP\kur-$ad.log"; if(Test-Path $lg){ Write-Host "--- INNO LOG SON 6 SATIR ---"; Get-Content $lg -Tail 6 }
            return $true
          }
          if(Test-Path "C:\CWPS-TEST\unins000.exe"){
            Write-Host "Once musteri kurulumu kaldiriliyor (AppId cakismasi olmasin)"
            Start-Process "C:\CWPS-TEST\unins000.exe" -ArgumentList "/VERYSILENT","/SUPPRESSMSGBOXES","/NORESTART" -PassThru | Wait-Process -Timeout 600 -ErrorAction SilentlyContinue
            # kaldirici/kurulum surecleri TAMAMEN bitene kadar bekle (yoksa satici kurulumu takilir) ✓
            for($i=0; $i -lt 90; $i++){
              $k = @(Get-Process -Name "unins*","CWPS-Setup*","*_iu*","_iu*" -ErrorAction SilentlyContinue)
              if($k.Count -eq 0){ break }
              Write-Host ("bekleniyor... kalan surec: " + ($k | ForEach-Object { $_.ProcessName }) )
              Start-Sleep -Seconds 5
            }
            Start-Sleep -Seconds 5
          }
          # SATICI oncesi: TUM kalintilari kapat (kaldirici/setup/edge dahil) ✓
          taskkill /F /IM CWPS.exe 2>$null | Out-Null
          taskkill /F /IM CWPS-Keygen.exe 2>$null | Out-Null
          taskkill /F /IM unins000.exe 2>$null | Out-Null
          taskkill /F /IM msedge.exe 2>$null | Out-Null
          Get-Process -ErrorAction SilentlyContinue | Where-Object { $_.ProcessName -like "*_iu*" -or $_.ProcessName -like "CWPS-Setup*" -or $_.ProcessName -like "unins*" } | Stop-Process -Force -ErrorAction SilentlyContinue
          Start-Sleep -Seconds 8
          Write-Host "kalan surecler:"; Get-Process | Where-Object { $_.ProcessName -match "CWPS|unins|iu|msedge" } | Select-Object ProcessName,Id | Format-Table -AutoSize | Out-String
          $s = (Get-ChildItem OutputSatici -Filter *.exe | Select-Object -First 1)
          $k1 = Kur $s "satici" "C:\KW-TEST" 2700   # 45 dk (Defender taramasi yavaslatabiliyor)
          Start-Sleep -Seconds 2
          $ok=0; $hata=0
          if(-not $k1){ Write-Host "FAIL  satici kurulumu TAMAMLANMADI (takildi)"; $hata++ }
          if(Test-Path "C:\KW-TEST\CWPS-Keygen.exe"){ Write-Host ("PASS  satici kurulumunda CWPS-Keygen.exe VAR -> " + [Math]::Round((Get-Item "C:\KW-TEST\CWPS-Keygen.exe").Length/1KB,0) + " KB"); $ok++ } else { Write-Host "FAIL  satici kurulumunda keygen YOK"; $hata++ }
          if(Test-Path "C:\KW-TEST\CWPS.exe"){ Write-Host "PASS  satici kurulumunda CWPS.exe var"; $ok++ } else { Write-Host "FAIL  CWPS.exe yok"; $hata++ }
          if(Test-Path "C:\KW-TEST\araclar"){ Write-Host ("PASS  araclar klasoru kuruldu (" + (Get-ChildItem "C:\KW-TEST\araclar" -Filter *.exe).Count + " arac)"); $ok++ } else { Write-Host "UYARI araclar klasoru yok"; }
          Write-Host ("SATICI TEST SONUC: PASS=" + $ok + " HATA=" + $hata)
          if($hata -gt 0){ exit 1 }
      - name: GERCEK KALDIRMA TESTI (sure sinirli)
        shell: pwsh
        run: |
          $u="C:\KW-TEST\unins000.exe"
          if(-not (Test-Path $u)){ Write-Host "FAIL  kaldirici yok: $u"; exit 1 }
          $t0=Get-Date
          $p=Start-Process $u -ArgumentList "/VERYSILENT","/SUPPRESSMSGBOXES","/NORESTART" -PassThru
          $ok2=$p.WaitForExit(420000)
          if(-not $ok2){ Write-Host ("FAIL  kaldirma 420 sn'de bitmedi - zorla kapatiliyor"); Stop-Process -Id $p.Id -Force -ErrorAction SilentlyContinue; taskkill /F /IM unins000.exe 2>$null | Out-Null; Start-Sleep -Seconds 10 }
          else { Write-Host ("OK    kaldirma bitti (" + [Math]::Round(((Get-Date)-$t0).TotalSeconds,1) + " sn)") }
          Start-Sleep -Seconds 5
          if(Test-Path "C:\KW-TEST\CWPS.exe"){ Write-Host "FAIL  kaldirma sonrasi exe duruyor" } else { Write-Host "PASS  kaldirma calisti (exe silindi)" }
          if(Test-Path "C:\KW-TEST"){ Write-Host ("KALAN DOSYALAR: " + ((Get-ChildItem "C:\KW-TEST" -Force | Select-Object -ExpandProperty Name) -join ", ")) } else { Write-Host "PASS  klasor tamamen silindi" }

      - name: PAKETLERI ARTIFACT OLARAK YUKLE
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: cwps-kurulum-paketleri
          path: |
            Output/*.exe
            OutputSatici/*.exe
          if-no-files-found: warn
